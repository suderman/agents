#!/usr/bin/env bash
set -euo pipefail

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$source_dir/.." && pwd -P)"
runtime_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

# shellcheck source=../lib/runtime.sh
source "$source_dir/../lib/runtime.sh"
validate_runtime_destination "$runtime_dir" "$source_dir/.." extensions prompts themes
if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --check ) ]]; then
  echo "Use bootstrap [--check]" >&2
  exit 1
fi
copy_file() {
  local source="$1"
  local target="$2"
  local temporary

  if [[ ! -L "$target" && -f "$target" ]] && cmp -s -- "$source" "$target"; then
    return
  fi

  mkdir -p -- "$(dirname -- "$target")"
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  cp --dereference --preserve=mode -- "$source" "$temporary"
  chmod u+rw -- "$temporary"
  mv -fT -- "$temporary" "$target"
  trap - RETURN
}

merge_settings() {
  local target="$runtime_dir/settings.json"
  local existing temporary

  existing="$(mktemp)"
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  trap 'rm -f -- "$existing" "$temporary"' RETURN

  if [[ -e "$target" ]]; then
    cp -L -- "$target" "$existing"
  else
    printf '{}\n' >"$existing"
  fi

  jq -S -s '
    if (.[0] | type) != "object" or (.[1] | type) != "object" then
      error("Pi settings must be JSON objects")
    else
      # Retire pi-subagents settings without dropping other runtime-owned keys.
      (.[0] | del(.subagents)) * .[1]
    end
  ' "$existing" "$source_dir/settings.json" >"$temporary"
  chmod 0644 -- "$temporary"

  if [[ ! -L "$target" && -f "$target" ]] && cmp -s -- "$temporary" "$target"; then
    rm -f -- "$temporary"
  else
    mv -fT -- "$temporary" "$target"
  fi

  rm -f -- "$existing"
  trap - RETURN
}

copy_declared_entries() {
  local relative="$1"
  local source target temporary

  mkdir -p -- "$runtime_dir/$relative"
  shopt -s nullglob dotglob
  for source in "$source_dir/$relative"/*; do
    target="$runtime_dir/$relative/${source##*/}"
    if [[ -d "$source" ]]; then
      if [[ -L "$target" ]]; then
        temporary="$(mktemp -d "${target}.tmp.XXXXXX")"
        [[ -d "$target" ]] && cp -aL -- "$target"/. "$temporary"/
        rm -- "$target"
        mv -T -- "$temporary" "$target"
      fi
      mkdir -p -- "$target"
      cp -a -- "$source"/. "$target"/
    else
      copy_file "$source" "$target"
    fi
  done
  shopt -u nullglob dotglob
}

command -v jq >/dev/null || {
  echo "Pi bootstrap requires jq" >&2
  exit 1
}

# shellcheck source=../lib/shared-prompts.sh
source "$repo_root/lib/shared-prompts.sh"
validate_shared_prompts "$HOME/profile/prompts" "$source_dir/prompts"

jq -e 'type == "object"' "$source_dir/settings.json" >/dev/null
if [[ -e "$runtime_dir/settings.json" ]]; then
  jq -e 'type == "object"' "$runtime_dir/settings.json" >/dev/null
fi
[[ "${1:-}" != --check ]] || exit 0

mkdir -p -- "$runtime_dir"
merge_settings

for file in AGENTS.md keybindings.json mcp.json models.json pi-fff.json settings-extensions.json; do
  copy_file "$source_dir/$file" "$runtime_dir/$file"
done

# Native MCP replaces the retired adapter configuration and disposable caches.
rm -f -- "$runtime_dir/"{mcp-adapter.json,mcp-cache.json,mcp-npx-cache.json}

for directory in extensions prompts themes; do
  copy_declared_entries "$directory"
done
copy_shared_prompts "$HOME/profile/prompts" "$runtime_dir/prompts"
