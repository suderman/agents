#!/usr/bin/env python3
"""Deploy Codex preferences, instructions, and personal skill discovery."""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

import tomllib

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from deploy import ROOT, destinations, mcp

SOURCE = ROOT / "codex"


def config_content(current):
    actual = tomllib.loads(current.decode())
    declared = tomllib.loads((SOURCE / "config.toml").read_text())
    servers = actual.get("mcp_servers", {})
    if not isinstance(servers, dict):
        raise TypeError("mcp_servers must be a TOML table")
    additions = {name: server for name, server in mcp["servers"](SOURCE / "mcp.json")["mcpServers"].items()
                 if name not in servers}
    if additions:
        declared["mcp_servers"] = additions
    expected = {**actual, **declared}
    if additions:
        expected["mcp_servers"] = {**servers, **additions}
    if expected == actual:
        return current
    # Write top-level maps as tables, after inline values that belong at the root.
    merge = (
        '. * (strenv(CODEX_DECLARED) | from_json) | (.[] | select(kind == "map")) style="" | to_entries | '
        'sort_by((.value | (kind == "map" or (kind == "seq" and (.[0] | kind == "map"))))) | from_entries'
    )
    result = subprocess.run(
        ["yq", "-p", "toml", "-o", "toml", merge],
        input=current or b"\n", capture_output=True,
        env={**os.environ, "CODEX_DECLARED": json.dumps(declared)}, check=False,
    )
    if result.returncode or tomllib.loads(result.stdout.decode()) != expected:
        raise ValueError("could not merge config.toml without changing existing TOML values")
    return result.stdout


def private_copy(path, content, *, backup=False):
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(content)
        if not backup:
            os.replace(temporary, path)
    finally:
        if not backup:
            Path(temporary).unlink(missing_ok=True)


def main():
    args = sys.argv[1:]
    try:
        if args not in ([], ["--check"], ["--verify"]):
            raise ValueError("use bootstrap [--check|--verify]")
        home = Path.home()
        runtime = destinations()["codex"]
        resolved = runtime.resolve()
        if (resolved in {Path("/"), home.resolve()} or resolved.is_relative_to(ROOT)
                or resolved.is_relative_to((home / "profile").resolve())):
            raise ValueError(f"unsafe runtime destination: {runtime}")
        if runtime.exists() and not runtime.is_dir():
            raise ValueError(f"runtime destination is not a directory: {runtime}")
        skill_root = runtime / "skills"
        if skill_root.is_symlink() or skill_root.exists() and not skill_root.is_dir():
            raise ValueError(f"Codex skill root must be a real directory: {skill_root}")
        link = skill_root / "agents-profile"
        personal = home / "profile/skills"
        linked = link.is_symlink() and link.readlink() == personal
        if personal.is_dir() and not linked and (link.exists() or link.is_symlink()):
            raise ValueError(f"Codex personal skill link collision: {link}")

        config = runtime / "config.toml"
        instructions = runtime / "AGENTS.md"
        old_config = config.read_bytes() if config.exists() else b""
        old_instructions = instructions.read_bytes() if instructions.exists() else b""
        try:
            settings = config_content(old_config)
        except tomllib.TOMLDecodeError as error:
            raise ValueError(f"invalid or unsupported TOML in {config}: {error}") from error
        files = ((config, old_config, settings), (instructions, old_instructions, (SOURCE / "AGENTS.md").read_bytes()))
        if args == ["--check"]:
            return
        for path, old, content in files:
            if not path.is_symlink() and path.is_file() and old == content and path.stat().st_mode & 0o600 == 0o600:
                continue
            if args == ["--verify"]:
                raise ValueError(f"Codex deployment mismatch: {path}")
            runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
            if path.exists() and old != content:
                backup = runtime / "backups"
                backup.mkdir(mode=0o700, exist_ok=True)
                private_copy(backup / f"agents-{path.name}", old, backup=True)
            private_copy(path, content)
        if personal.is_dir() and not linked:
            if args == ["--verify"]:
                raise ValueError(f"Codex deployment mismatch: {link}")
            skill_root.mkdir(exist_ok=True)
            link.symlink_to(personal, target_is_directory=True)
    except (OSError, ValueError, TypeError) as error:
        sys.exit(f"codex bootstrap: {error}")


if __name__ == "__main__":
    main()
