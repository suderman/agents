#!/usr/bin/env bash
set -euo pipefail

# Batch tests for org-edit against fixture Org files. Needs only emacs.

org="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fixture="$(mktemp -d)"
trap 'rm -rf -- "$fixture"' EXIT
export HOME="$fixture/home"
mkdir -p "$HOME/org"

edit="$org/edit/org-edit"
failures=0

check() {
  local name=$1
  shift
  if "$@"; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    failures=$((failures + 1))
  fi
}

run() { bash "$edit" "$@" 2>&1 || true; }
has() { grep -q -- "$2" <<<"$1"; }
line() { grep -q -- "$2" "$1"; }
lacks_line() { ! grep -q -- "$2" "$1"; }

tasks="$HOME/org/tasks.org"
cat >"$tasks" <<'EOF'
* TODO Fix the thing :kit:
* TODO [#A] Water plants
SCHEDULED: <2026-10-01 Thu +1w>
* TODO Twin
* TODO Twin
:PROPERTIES:
:ID:       twin-two
:END:
* HOLD Plan
EOF

out=$(run todo "$tasks" "Fix the thing" prog)
check "todo sets a state by title" line "$tasks" '^\* PROG Fix the thing :kit:$'
check "todo prints the heading" has "$out" 'PROG Fix the thing'

run todo "$tasks" "Fix the thing" DONE >/dev/null
check "DONE writes CLOSED" line "$tasks" '^CLOSED: \[20'

run todo "$tasks" "Water plants" DONE >/dev/null
check "DONE on a repeater advances it" line "$tasks" 'SCHEDULED: <2026-10-08 Thu +1w>'
check "the repeater stays TODO" line "$tasks" '^\* TODO \[#A\] Water plants$'
check "the repeat is logged" line "$tasks" '^- State "DONE"       from "TODO"'

out=$(run todo "$tasks" "Plan" AUTO)
check "AUTO is refused" has "$out" 'only Jon sets AUTO'
out=$(run todo "$tasks" "Plan" WAIT)
check "an unknown state is refused" has "$out" 'STATE is one of'
check "refusals leave the file" line "$tasks" '^\* HOLD Plan$'

out=$(run todo "$tasks" "Twin" PROG)
check "a duplicate title is refused" has "$out" '2 headings'
run todo "$tasks" "id:twin-two" PROG >/dev/null
check "id: picks one" line "$tasks" '^\* PROG Twin$'

run schedule "$tasks" "Plan" "2026-11-03 9:00" >/dev/null
check "schedule writes the weekday" line "$tasks" '^SCHEDULED: <2026-11-03 Tue 09:00>$'
run deadline "$tasks" "Plan" "2026-11-06 -2d" >/dev/null
check "deadline joins the planning line" line "$tasks" 'DEADLINE: <2026-11-06 Fri -2d>'
run schedule "$tasks" "Plan" none >/dev/null
check "none removes SCHEDULED" lacks_line "$tasks" 'SCHEDULED: <2026-11-03'
check "and keeps DEADLINE" line "$tasks" 'DEADLINE: <2026-11-06 Fri -2d>'

check "date prints a timestamp" has "$(run date '2026-11-03 9:00-10:30 +1w')" '^<2026-11-03 Tue 09:00-10:30 +1w>$'
check "date takes a relative day" has "$(run date '+0d')" "^<$(date +'%Y-%m-%d %a')>$"
check "date refuses words Org would read as today" has "$(run date 'next tuesday')" 'not a date'

cp "$tasks" "$HOME/org/asana.org"
check "asana.org is refused" has "$(run todo "$HOME/org/asana.org" Plan DONE)" 'never edit it'
cp "$tasks" "$HOME/org/tasks.sync-conflict-20261024-000000-ABC.org"
check "conflict copies are refused" \
  has "$(run todo "$HOME/org/tasks.sync-conflict-20261024-000000-ABC.org" Plan DONE)" 'conflict copy'

if ((failures)); then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
