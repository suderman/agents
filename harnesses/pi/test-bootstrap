#!/usr/bin/env bash
set -euo pipefail

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$source_dir/../.." && pwd -P)"
fixture="$(mktemp -d)"
trap 'rm -rf -- "$fixture"' EXIT
export PI_CODING_AGENT_DIR="$fixture/agent"
export XDG_STATE_HOME="$fixture/state"
mkdir -p "$PI_CODING_AGENT_DIR/themes"

printf '{"runtimeOnly":true,"lastChangelogVersion":"test","subagents":{"agentOverrides":{"scout":{"model":"retired"}}},"packages":["npm:pi-subagents"]}\n' >"$PI_CODING_AGENT_DIR/settings.json"
printf 'private runtime secret\n' >"$PI_CODING_AGENT_DIR/.env"
printf 'saved runtime state\n' >"$PI_CODING_AGENT_DIR/runtime-state"
for file in mcp-adapter.json mcp-cache.json mcp-npx-cache.json; do
  printf '{"oldAdapterState":true}\n' >"$PI_CODING_AGENT_DIR/$file"
done
printf '{"name":"stylix","generated":true}\n' >"$PI_CODING_AGENT_DIR/themes/stylix.json"

runtime_hashes() {
  sha256sum "$PI_CODING_AGENT_DIR/"{.env,runtime-state,themes/stylix.json}
}

before="$(runtime_hashes)"
"$source_dir/bootstrap"
cmp "$source_dir/mcp.json" "$PI_CODING_AGENT_DIR/mcp.json"
for name in commit commitall; do
  cmp "$repo_root/prompts/$name.md" "$PI_CODING_AGENT_DIR/prompts/$name.md"
  [[ ! -L "$PI_CODING_AGENT_DIR/prompts/$name.md" && -w "$PI_CODING_AGENT_DIR/prompts/$name.md" ]]
done
jq -e '
  .runtimeOnly == true and .lastChangelogVersion == "test" and
  .defaultTools == ["+codemode"] and .theme == "stylix" and
  (.packages | index("npm:pi-mcp-adapter") == null) and
  (.packages | index("npm:pi-subagents") == null) and
  (has("subagents") | not)
' "$PI_CODING_AGENT_DIR/settings.json" >/dev/null
jq -e '
  (.mcpServers | keys | length) == 4 and
  .mcpServers["chrome-devtools"].exposure == "direct" and
  ([.mcpServers[] | .description | type == "string" and length > 0] | all)
' "$PI_CODING_AGENT_DIR/mcp.json" >/dev/null
[[ ! -L "$PI_CODING_AGENT_DIR/mcp.json" && -w "$PI_CODING_AGENT_DIR/mcp.json" ]]
[[ "$(runtime_hashes)" == "$before" ]]
for file in mcp-adapter.json mcp-cache.json mcp-npx-cache.json; do
  [[ ! -e "$PI_CODING_AGENT_DIR/$file" && ! -L "$PI_CODING_AGENT_DIR/$file" ]]
done
grep -q 'mcp__chrome_devtools__take_snapshot' "$PI_CODING_AGENT_DIR/AGENTS.md"
! grep -q 'subagents:' "$PI_CODING_AGENT_DIR/AGENTS.md"

first="$(sha256sum "$PI_CODING_AGENT_DIR/settings.json" "$PI_CODING_AGENT_DIR/mcp.json")"
stats="$(stat -c '%i:%Y:%a' "$PI_CODING_AGENT_DIR/settings.json" "$PI_CODING_AGENT_DIR/mcp.json")"
prompts="$(sha256sum "$PI_CODING_AGENT_DIR/prompts/"*.md; stat -c '%i:%Y:%a' "$PI_CODING_AGENT_DIR/prompts/"*.md)"
"$source_dir/bootstrap"
[[ "$(sha256sum "$PI_CODING_AGENT_DIR/settings.json" "$PI_CODING_AGENT_DIR/mcp.json")" == "$first" ]]
[[ "$(stat -c '%i:%Y:%a' "$PI_CODING_AGENT_DIR/settings.json" "$PI_CODING_AGENT_DIR/mcp.json")" == "$stats" ]]
[[ "$(sha256sum "$PI_CODING_AGENT_DIR/prompts/"*.md; stat -c '%i:%Y:%a' "$PI_CODING_AGENT_DIR/prompts/"*.md)" == "$prompts" ]]
[[ "$(runtime_hashes)" == "$before" ]]

"$source_dir/fix-dcp-package"
manifest="$PI_CODING_AGENT_DIR/npm/node_modules/@pi-vault/pi-dcp/package.json"
mkdir -p -- "$(dirname -- "$manifest")"
printf '%s\n' '{"dependencies":{"typebox":"^1.3.19","unrelated":"1.0.0"},"peerDependencies":{"host":"*"},"devDependencies":{"typebox":"^1.3.19"}}' >"$manifest"
chmod 0640 "$manifest"
"$source_dir/fix-dcp-package"
jq -e '
  .dependencies.typebox == null and .peerDependencies.typebox == "*" and
  .dependencies.unrelated == "1.0.0" and .peerDependencies.host == "*" and
  .devDependencies.typebox == "^1.3.19"
' "$manifest" >/dev/null
[[ "$(stat -c '%a' "$manifest")" == 640 ]]
first="$(sha256sum "$manifest"; stat -c '%i:%Y:%a' "$manifest")"
"$source_dir/fix-dcp-package"
[[ "$(sha256sum "$manifest"; stat -c '%i:%Y:%a' "$manifest")" == "$first" ]]
[[ "$(runtime_hashes)" == "$before" ]]

printf 'Pi bootstrap checks passed: native MCP, codemode, shared prompts, retired subagents, state/theme, package repair, repeat runs.\n'
