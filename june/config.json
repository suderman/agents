{
  "user": {
    "name": "Jon"
  },
  "model": {
    "chat": {
      "provider": "cliproxyapi",
      "modelId": "gpt-6.1-terra",
      "thinkingLevel": "medium"
    },
    "focus": {
      "modelId": "gpt-6.1-sol",
      "thinkingLevel": "medium"
    },
    "patter": {
      "modelId": "gpt-6-luna"
    }
  },
  "providersFile": "~/.pi/agent/models.json",
  "contextCap": 200000,
  "skillDirs": [
    "~/.agents/skills",
    "~/profile/skills"
  ],
  "org": {
    "root": "~/org"
  },
  "herdr": {
    "session": "default",
    "hosts": {
      "cog": {},
      "lux": {}
    }
  },
  "dispatch": {
    "hosts": [
      "kit",
      "cog"
    ]
  },
  "rhythm": {
    "wake": "05:00",
    "quiet": "22:00",
    "sleep": "01:00"
  },
  "reflection": {
    "enabled": true,
    "quietMinutes": 60,
    "recentDays": 3
  },
  "heartbeat": {
    "enabled": true,
    "everyMinutes": 60,
    "chattingMinutes": 15
  },
  "mail": { "enabled": true, "query": "tag:inbox and tag:unread", "accounts": { "suderman": "home", "nonfiction": "work" } },
  "watch": { "enabled": true, "gapMinutes": 10 },
  "patter": {
    "openAfterSeconds": 8,
    "gapsSeconds": [
      25,
      25,
      25,
      40,
      60,
      90,
      120,
      180
    ]
  },
  "situation": {
    "calendars": [
      "~/org/calendar/family.org",
      "~/org/calendar/work.org",
      "~/org/calendar/wife.org",
      "~/org/calendar/garbage.org",
      "~/org/calendar/events.org",
      "~/org/calendar/fresha.org"
    ],
    "homeAssistant": {
      "people": [
        "person.jon_suderman"
      ],
      "weather": "weather.calgary_forecast",
      "pollSeconds": 300
    }
  }
}
